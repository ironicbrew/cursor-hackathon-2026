# ===================
# Frontend (Vite bundles these into the client)
# ===================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_DEMO_MODE=false

# ===================
# Server-side only (API routes / Inngest — not bundled into the client)
# ===================
SUPABASE_URL=https://your-project.supabase.co

# Secret key from Supabase → Project Settings → API (sb_secret_… or legacy service_role JWT).
# Define this only once — duplicate keys in .env override with the last value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

OPENAI_API_KEY=your-openai-key

# ===================
# Local dev (npm run dev:all)
# Frontend (Vite): http://127.0.0.1:3000  |  API (vercel dev): :3001  |  Inngest UI: :8288
# Use 127.0.0.1 on Windows if localhost fails
# ===================
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_BASE_URL=http://127.0.0.1:8288

# ===================
# Production (Inngest Cloud) — uncomment and set in Vercel env
# ===================
# INNGEST_DEV=0
# INNGEST_EVENT_KEY=your-inngest-event-key
# INNGEST_SIGNING_KEY=your-inngest-signing-key
